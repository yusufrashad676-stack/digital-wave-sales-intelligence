# Supabase PostgreSQL — put real values in .env (gitignored), never commit them.
# The two variables below are placeholders describing the expected shape.

# Prisma CLI / migrations (prisma.config.ts reads this). Use the Supabase DIRECT
# connection on port 5432 — the plain postgresql:// scheme. Do NOT use prisma+postgres://
# (that scheme is Prisma Postgres-only and is not accepted by Supabase).
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Runtime database connection for the application (pg driver adapter in PrismaService).
# Direct connection on port 5432 is fine for a single long-running Node instance (the
# adapter owns its pool). If Supabase's direct-connection limit is ever exhausted,
# switch to the transaction pooler on port 6543 (omit ?pgbouncer=true — the pg driver
# adapter reads the plain URL, not Prisma's pooler params).
DIRECT_DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Application
NODE_ENV="development"
APP_PORT=3000

# CORS allowlist (comma-separated). Empty = same-origin only.
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Global rate limiting
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# JWT (stateless auth). Secrets are never committed — replace with strong random values (>= 32 chars).
JWT_SECRET="REPLACE_WITH_RANDOM_ACCESS_SECRET_AT_LEAST_32_CHARS"
JWT_REFRESH_SECRET="REPLACE_WITH_RANDOM_REFRESH_SECRET_AT_LEAST_32_CHARS"
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
JWT_ALGORITHM="HS256"

# Stricter rate limits for auth endpoints (login, refresh, register)
AUTH_THROTTLE_TTL_SECONDS=60
AUTH_THROTTLE_LIMIT=10

# Search providers (Phase 2A).
# Provider selection:
#   - Unset/empty     -> "google-places". GOOGLE_MAPS_API_KEY is REQUIRED in that case and
#                        startup fails loudly when it is missing. A missing key NEVER selects
#                        mock.
#   - "google-places" -> real Google Places provider. Use this for production and real dev.
#   - "mock"          -> fabricated in-memory sample businesses for deterministic tests and
#                        explicit local demos. Refused when NODE_ENV=production.
SEARCH_PROVIDER=""
# Google Places API (New) server key. REQUIRED whenever SEARCH_PROVIDER is "google-places" or
# unset. Backend-only, never logged, never exposed to the frontend.
GOOGLE_MAPS_API_KEY=""
# Maximum results per search. Google Places Text Search (New) returns at most 20 per page.
SEARCH_MAX_RESULTS=20
# Timeout (ms) for a single Google Places request.
SEARCH_GOOGLE_TIMEOUT_MS=5000

# Optional enrichment (website / social discovery + canonical evidence promotion).
#   - "false"      -> discovery/leads work normally but NO optional website/social
#                     enrichment runs (the enrich endpoints reject the request).
#   - "true"/unset -> bounded optional enrichment runs within the limits below.
ENRICHMENT_ENABLED=true
# Per-request timeouts (ms) and concurrency bounds for enrichment providers.
ENRICHMENT_WEBSITE_TIMEOUT_MS=5000
ENRICHMENT_SOCIAL_TIMEOUT_MS=5000
ENRICHMENT_VERIFICATION_TIMEOUT_MS=3000
ENRICHMENT_MAX_CONCURRENT=5
# Hard bounds enforced by the SafeFetcher (SSRF-safe fetcher used by providers).
ENRICHMENT_MAX_RESPONSE_BYTES=1048576
ENRICHMENT_MAX_REDIRECTS=3
ENRICHMENT_USER_AGENT="DigitalWave"
ENRICHMENT_MAX_REQUEST_TIMEOUT_MS=300000
