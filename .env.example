# Prisma CLI / migrations (prisma.config.ts reads this). Local Prisma Postgres dev instance.
DATABASE_URL="prisma+postgres://localhost:51217/?api_key=YOUR_API_KEY"

# Runtime database connection for the application (pg driver adapter).
DIRECT_DATABASE_URL="postgres://postgres:postgres@localhost:51218/template1?sslmode=disable"

# Application
NODE_ENV="development"
APP_PORT=3000

# CORS allowlist (comma-separated). Empty = same-origin only.
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Global rate limiting
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# JWT (stateless auth). Secrets are never committed — replace with strong random values (>= 32 chars).
JWT_SECRET="REPLACE_WITH_RANDOM_ACCESS_SECRET_AT_LEAST_32_CHARS"
JWT_REFRESH_SECRET="REPLACE_WITH_RANDOM_REFRESH_SECRET_AT_LEAST_32_CHARS"
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
JWT_ALGORITHM="HS256"

# Stricter rate limits for auth endpoints (login, refresh, register)
AUTH_THROTTLE_TTL_SECONDS=60
AUTH_THROTTLE_LIMIT=10
