// Phase 1 Foundation Schema — Digital Wave Sales Intelligence Platform
// Status: DATABASE DESIGN FREEZE v1.0 (docs/MASTER_ARCHITECTURE.md §16)
// Scope: foundation models only (ADR-005 … ADR-010). No migrations, no seed.
// Conventions (docs/DATABASE_RULES.md):
//   - every column mapped to snake_case via @map; every table via @@map
//   - every FK column indexed (incl. audit actor columns)
//   - join-table pair identity via plain @@unique (re-assignment = restore)
//   - soft-delete-aware uniqueness via SQL partial indexes (ADR-005, registry in
//     DATABASE_RULES.md) created after the Prisma migration — never @@unique([x, deletedAt])

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  REGISTERED
  ACTIVE
  DISABLED
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum WorkspaceOwnerModel {
  SINGLE
  MULTI
}

enum RoleKind {
  SYSTEM
  CUSTOM
}

enum RoleStatus {
  CREATED
  ACTIVE
  DEPRECATED
}

enum PermissionScope {
  PLATFORM
  SCOPED
}

enum PermissionStatus {
  INTRODUCED
  ACTIVE
  DEPRECATED
}

enum PermissionGroupKind {
  DOMAIN
  CAPABILITY_LEVEL
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  DORMANT
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

model User {
  id          String     @id @default(uuid()) @map("id")
  email       String     @unique(map: "uq_users_email") @map("email") @db.VarChar(320)
  displayName String     @map("display_name") @db.VarChar(255)
  status      UserStatus @default(REGISTERED) @map("status")
  preferences Json?      @map("preferences")
  lastLoginAt DateTime?  @map("last_login_at") @db.Timestamptz

  createdById String?   @map("created_by_id")
  createdBy   User?     @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String?   @map("updated_by_id")
  updatedBy   User?     @relation("UserUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  deletedById String?   @map("deleted_by_id")
  deletedBy   User?     @relation("UserDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  roleAssignments RoleAssignment[]
  userWorkspaces  UserWorkspace[]

  createdUsers                  User[]                 @relation("UserCreatedBy")
  updatedUsers                  User[]                 @relation("UserUpdatedBy")
  deletedUsers                  User[]                 @relation("UserDeletedBy")
  createdWorkspaces             Workspace[]            @relation("WorkspaceCreatedBy")
  updatedWorkspaces             Workspace[]            @relation("WorkspaceUpdatedBy")
  deletedWorkspaces             Workspace[]            @relation("WorkspaceDeletedBy")
  createdRoles                  Role[]                 @relation("RoleCreatedBy")
  updatedRoles                  Role[]                 @relation("RoleUpdatedBy")
  deletedRoles                  Role[]                 @relation("RoleDeletedBy")
  createdPermissions            Permission[]           @relation("PermissionCreatedBy")
  updatedPermissions            Permission[]           @relation("PermissionUpdatedBy")
  deletedPermissions            Permission[]           @relation("PermissionDeletedBy")
  createdRoleAssignments        RoleAssignment[]       @relation("RoleAssignmentCreatedBy")
  updatedRoleAssignments        RoleAssignment[]       @relation("RoleAssignmentUpdatedBy")
  deletedRoleAssignments        RoleAssignment[]       @relation("RoleAssignmentDeletedBy")
  assignedRoleAssignments       RoleAssignment[]       @relation("RoleAssignmentAssignedBy")
  createdRolePermissions        RolePermission[]       @relation("RolePermissionCreatedBy")
  updatedRolePermissions        RolePermission[]       @relation("RolePermissionUpdatedBy")
  deletedRolePermissions        RolePermission[]       @relation("RolePermissionDeletedBy")
  assignedRolePermissions       RolePermission[]       @relation("RolePermissionAssignedBy")
  createdUserWorkspaces         UserWorkspace[]        @relation("UserWorkspaceCreatedBy")
  updatedUserWorkspaces         UserWorkspace[]        @relation("UserWorkspaceUpdatedBy")
  deletedUserWorkspaces         UserWorkspace[]        @relation("UserWorkspaceDeletedBy")
  assignedUserWorkspaces        UserWorkspace[]        @relation("UserWorkspaceAssignedBy")
  createdCompanies              Company[]              @relation("CompanyCreatedBy")
  updatedCompanies              Company[]              @relation("CompanyUpdatedBy")
  deletedCompanies              Company[]              @relation("CompanyDeletedBy")
  createdBranches               Branch[]               @relation("BranchCreatedBy")
  updatedBranches               Branch[]               @relation("BranchUpdatedBy")
  deletedBranches               Branch[]               @relation("BranchDeletedBy")
  createdPeople                 Person[]               @relation("PersonCreatedBy")
  updatedPeople                 Person[]               @relation("PersonUpdatedBy")
  deletedPeople                 Person[]               @relation("PersonDeletedBy")
  createdAddresses              Address[]              @relation("AddressCreatedBy")
  updatedAddresses              Address[]              @relation("AddressUpdatedBy")
  deletedAddresses              Address[]              @relation("AddressDeletedBy")
  createdWebsites               Website[]              @relation("WebsiteCreatedBy")
  updatedWebsites               Website[]              @relation("WebsiteUpdatedBy")
  deletedWebsites               Website[]              @relation("WebsiteDeletedBy")
  createdSocialProfiles         SocialProfile[]        @relation("SocialProfileCreatedBy")
  updatedSocialProfiles         SocialProfile[]        @relation("SocialProfileUpdatedBy")
  deletedSocialProfiles         SocialProfile[]        @relation("SocialProfileDeletedBy")
  createdContactMethods         ContactMethod[]        @relation("ContactMethodCreatedBy")
  updatedContactMethods         ContactMethod[]        @relation("ContactMethodUpdatedBy")
  deletedContactMethods         ContactMethod[]        @relation("ContactMethodDeletedBy")
  createdTags                   Tag[]                  @relation("TagCreatedBy")
  updatedTags                   Tag[]                  @relation("TagUpdatedBy")
  deletedTags                   Tag[]                  @relation("TagDeletedBy")
  createdCategories             Category[]             @relation("CategoryCreatedBy")
  updatedCategories             Category[]             @relation("CategoryUpdatedBy")
  deletedCategories             Category[]             @relation("CategoryDeletedBy")
  createdEmployments            Employment[]           @relation("EmploymentCreatedBy")
  updatedEmployments            Employment[]           @relation("EmploymentUpdatedBy")
  deletedEmployments            Employment[]           @relation("EmploymentDeletedBy")
  createdCompanyAddresses       CompanyAddress[]       @relation("CompanyAddressCreatedBy")
  updatedCompanyAddresses       CompanyAddress[]       @relation("CompanyAddressUpdatedBy")
  deletedCompanyAddresses       CompanyAddress[]       @relation("CompanyAddressDeletedBy")
  assignedCompanyAddresses      CompanyAddress[]       @relation("CompanyAddressAssignedBy")
  createdBranchAddresses        BranchAddress[]        @relation("BranchAddressCreatedBy")
  updatedBranchAddresses        BranchAddress[]        @relation("BranchAddressUpdatedBy")
  deletedBranchAddresses        BranchAddress[]        @relation("BranchAddressDeletedBy")
  assignedBranchAddresses       BranchAddress[]        @relation("BranchAddressAssignedBy")
  createdPersonContactMethods   PersonContactMethod[]  @relation("PersonContactMethodCreatedBy")
  updatedPersonContactMethods   PersonContactMethod[]  @relation("PersonContactMethodUpdatedBy")
  deletedPersonContactMethods   PersonContactMethod[]  @relation("PersonContactMethodDeletedBy")
  assignedPersonContactMethods  PersonContactMethod[]  @relation("PersonContactMethodAssignedBy")
  createdCompanyContactMethods  CompanyContactMethod[] @relation("CompanyContactMethodCreatedBy")
  updatedCompanyContactMethods  CompanyContactMethod[] @relation("CompanyContactMethodUpdatedBy")
  deletedCompanyContactMethods  CompanyContactMethod[] @relation("CompanyContactMethodDeletedBy")
  assignedCompanyContactMethods CompanyContactMethod[] @relation("CompanyContactMethodAssignedBy")
  createdBranchContactMethods   BranchContactMethod[]  @relation("BranchContactMethodCreatedBy")
  updatedBranchContactMethods   BranchContactMethod[]  @relation("BranchContactMethodUpdatedBy")
  deletedBranchContactMethods   BranchContactMethod[]  @relation("BranchContactMethodDeletedBy")
  assignedBranchContactMethods  BranchContactMethod[]  @relation("BranchContactMethodAssignedBy")
  createdCompanyWebsites        CompanyWebsite[]       @relation("CompanyWebsiteCreatedBy")
  updatedCompanyWebsites        CompanyWebsite[]       @relation("CompanyWebsiteUpdatedBy")
  deletedCompanyWebsites        CompanyWebsite[]       @relation("CompanyWebsiteDeletedBy")
  assignedCompanyWebsites       CompanyWebsite[]       @relation("CompanyWebsiteAssignedBy")
  createdBranchWebsites         BranchWebsite[]        @relation("BranchWebsiteCreatedBy")
  updatedBranchWebsites         BranchWebsite[]        @relation("BranchWebsiteUpdatedBy")
  deletedBranchWebsites         BranchWebsite[]        @relation("BranchWebsiteDeletedBy")
  assignedBranchWebsites        BranchWebsite[]        @relation("BranchWebsiteAssignedBy")
  createdPersonSocialProfiles   PersonSocialProfile[]  @relation("PersonSocialProfileCreatedBy")
  updatedPersonSocialProfiles   PersonSocialProfile[]  @relation("PersonSocialProfileUpdatedBy")
  deletedPersonSocialProfiles   PersonSocialProfile[]  @relation("PersonSocialProfileDeletedBy")
  assignedPersonSocialProfiles  PersonSocialProfile[]  @relation("PersonSocialProfileAssignedBy")
  createdCompanySocialProfiles  CompanySocialProfile[] @relation("CompanySocialProfileCreatedBy")
  updatedCompanySocialProfiles  CompanySocialProfile[] @relation("CompanySocialProfileUpdatedBy")
  deletedCompanySocialProfiles  CompanySocialProfile[] @relation("CompanySocialProfileDeletedBy")
  assignedCompanySocialProfiles CompanySocialProfile[] @relation("CompanySocialProfileAssignedBy")
  createdBranchSocialProfiles   BranchSocialProfile[]  @relation("BranchSocialProfileCreatedBy")
  updatedBranchSocialProfiles   BranchSocialProfile[]  @relation("BranchSocialProfileUpdatedBy")
  deletedBranchSocialProfiles   BranchSocialProfile[]  @relation("BranchSocialProfileDeletedBy")
  assignedBranchSocialProfiles  BranchSocialProfile[]  @relation("BranchSocialProfileAssignedBy")
  createdCompanyTags            CompanyTag[]           @relation("CompanyTagCreatedBy")
  updatedCompanyTags            CompanyTag[]           @relation("CompanyTagUpdatedBy")
  deletedCompanyTags            CompanyTag[]           @relation("CompanyTagDeletedBy")
  assignedCompanyTags           CompanyTag[]           @relation("CompanyTagAssignedBy")
  createdPersonTags             PersonTag[]            @relation("PersonTagCreatedBy")
  updatedPersonTags             PersonTag[]            @relation("PersonTagUpdatedBy")
  deletedPersonTags             PersonTag[]            @relation("PersonTagDeletedBy")
  assignedPersonTags            PersonTag[]            @relation("PersonTagAssignedBy")
  createdCompanyCategories      CompanyCategory[]      @relation("CompanyCategoryCreatedBy")
  updatedCompanyCategories      CompanyCategory[]      @relation("CompanyCategoryUpdatedBy")
  deletedCompanyCategories      CompanyCategory[]      @relation("CompanyCategoryDeletedBy")
  assignedCompanyCategories     CompanyCategory[]      @relation("CompanyCategoryAssignedBy")

  @@index([status], map: "idx_users_status")
  @@index([lastLoginAt], map: "idx_users_last_login_at")
  @@index([createdById], map: "idx_users_created_by_id")
  @@index([updatedById], map: "idx_users_updated_by_id")
  @@index([deletedById], map: "idx_users_deleted_by_id")
  @@map("users")
}

model Workspace {
  id              String              @id @default(uuid()) @map("id")
  code            String              @unique(map: "uq_workspaces_code") @map("code") @db.VarChar(64)
  name            String              @map("name") @db.VarChar(255)
  status          WorkspaceStatus     @default(ACTIVE) @map("status")
  ownerModel      WorkspaceOwnerModel @default(SINGLE) @map("owner_model")
  defaultSettings Json?               @map("default_settings")

  createdById String?   @map("created_by_id")
  createdBy   User?     @relation("WorkspaceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String?   @map("updated_by_id")
  updatedBy   User?     @relation("WorkspaceUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  deletedById String?   @map("deleted_by_id")
  deletedBy   User?     @relation("WorkspaceDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  users UserWorkspace[] @relation("UserWorkspaceWorkspace")
  roles Role[]          @relation("RoleWorkspace")

  @@index([status], map: "idx_workspaces_status")
  @@index([createdById], map: "idx_workspaces_created_by_id")
  @@index([updatedById], map: "idx_workspaces_updated_by_id")
  @@index([deletedById], map: "idx_workspaces_deleted_by_id")
  @@map("workspaces")
}

model Role {
  id          String     @id @default(uuid()) @map("id")
  code        String     @unique(map: "uq_roles_code") @map("code") @db.VarChar(64)
  name        String     @map("name") @db.VarChar(255)
  description String?    @map("description") @db.VarChar(2000)
  kind        RoleKind   @default(CUSTOM) @map("kind")
  status      RoleStatus @default(CREATED) @map("status")
  parentId    String?    @map("parent_id")
  parent      Role?      @relation("RoleHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Role[]     @relation("RoleHierarchy")
  workspaceId String?    @map("workspace_id")
  workspace   Workspace? @relation("RoleWorkspace", fields: [workspaceId], references: [id], onDelete: Restrict)

  createdById String?   @map("created_by_id")
  createdBy   User?     @relation("RoleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String?   @map("updated_by_id")
  updatedBy   User?     @relation("RoleUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  deletedById String?   @map("deleted_by_id")
  deletedBy   User?     @relation("RoleDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  roleAssignments RoleAssignment[]
  rolePermissions RolePermission[]

  @@index([status], map: "idx_roles_status")
  @@index([parentId], map: "idx_roles_parent_id")
  @@index([workspaceId], map: "idx_roles_workspace_id")
  @@index([createdById], map: "idx_roles_created_by_id")
  @@index([updatedById], map: "idx_roles_updated_by_id")
  @@index([deletedById], map: "idx_roles_deleted_by_id")
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @map("id")
  code        String           @unique(map: "uq_permissions_code") @map("code") @db.VarChar(128)
  name        String           @map("name") @db.VarChar(255)
  groupId     String           @map("group_id")
  group       PermissionGroup  @relation(fields: [groupId], references: [id], onDelete: Restrict)
  scope       PermissionScope  @default(PLATFORM) @map("scope")
  description String?          @map("description") @db.VarChar(2000)
  status      PermissionStatus @default(INTRODUCED) @map("status")

  createdById String?   @map("created_by_id")
  createdBy   User?     @relation("PermissionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String?   @map("updated_by_id")
  updatedBy   User?     @relation("PermissionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  deletedById String?   @map("deleted_by_id")
  deletedBy   User?     @relation("PermissionDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  rolePermissions RolePermission[]

  @@index([groupId], map: "idx_permissions_group_id")
  @@index([status], map: "idx_permissions_status")
  @@index([createdById], map: "idx_permissions_created_by_id")
  @@index([updatedById], map: "idx_permissions_updated_by_id")
  @@index([deletedById], map: "idx_permissions_deleted_by_id")
  @@map("permissions")
}

model RoleAssignment {
  id           String    @id @default(uuid()) @map("id")
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  roleId       String    @map("role_id")
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedById String?   @map("assigned_by_id")
  assignedBy   User?     @relation("RoleAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  assignedAt   DateTime? @map("assigned_at") @db.Timestamptz

  createdById String?   @map("created_by_id")
  createdBy   User?     @relation("RoleAssignmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String?   @map("updated_by_id")
  updatedBy   User?     @relation("RoleAssignmentUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  deletedById String?   @map("deleted_by_id")
  deletedBy   User?     @relation("RoleAssignmentDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  @@unique([userId, roleId], map: "uq_role_assignments_user_id_role_id")
  @@index([userId], map: "idx_role_assignments_user_id")
  @@index([roleId], map: "idx_role_assignments_role_id")
  @@index([assignedById], map: "idx_role_assignments_assigned_by_id")
  @@index([createdById], map: "idx_role_assignments_created_by_id")
  @@index([updatedById], map: "idx_role_assignments_updated_by_id")
  @@index([deletedById], map: "idx_role_assignments_deleted_by_id")
  @@map("role_assignments")
}

model RolePermission {
  id           String     @id @default(uuid()) @map("id")
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  assignedById String?    @map("assigned_by_id")
  assignedBy   User?      @relation("RolePermissionAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  assignedAt   DateTime?  @map("assigned_at") @db.Timestamptz

  createdById String?   @map("created_by_id")
  createdBy   User?     @relation("RolePermissionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String?   @map("updated_by_id")
  updatedBy   User?     @relation("RolePermissionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  deletedById String?   @map("deleted_by_id")
  deletedBy   User?     @relation("RolePermissionDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  @@unique([roleId, permissionId], map: "uq_role_permissions_role_id_permission_id")
  @@index([roleId], map: "idx_role_permissions_role_id")
  @@index([permissionId], map: "idx_role_permissions_permission_id")
  @@index([assignedById], map: "idx_role_permissions_assigned_by_id")
  @@index([createdById], map: "idx_role_permissions_created_by_id")
  @@index([updatedById], map: "idx_role_permissions_updated_by_id")
  @@index([deletedById], map: "idx_role_permissions_deleted_by_id")
  @@map("role_permissions")
}

model UserWorkspace {
  id           String    @id @default(uuid()) @map("id")
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  workspaceId  String    @map("workspace_id")
  workspace    Workspace @relation("UserWorkspaceWorkspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  assignedById String?   @map("assigned_by_id")
  assignedBy   User?     @relation("UserWorkspaceAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  assignedAt   DateTime? @map("assigned_at") @db.Timestamptz

  createdById String?   @map("created_by_id")
  createdBy   User?     @relation("UserWorkspaceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String?   @map("updated_by_id")
  updatedBy   User?     @relation("UserWorkspaceUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  deletedById String?   @map("deleted_by_id")
  deletedBy   User?     @relation("UserWorkspaceDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  @@unique([userId, workspaceId], map: "uq_user_workspaces_user_id_workspace_id")
  @@index([userId], map: "idx_user_workspaces_user_id")
  @@index([workspaceId], map: "idx_user_workspaces_workspace_id")
  @@index([assignedById], map: "idx_user_workspaces_assigned_by_id")
  @@index([createdById], map: "idx_user_workspaces_created_by_id")
  @@index([updatedById], map: "idx_user_workspaces_updated_by_id")
  @@index([deletedById], map: "idx_user_workspaces_deleted_by_id")
  @@map("user_workspaces")
}

model ContactMethodType {
  id          String   @id @default(uuid()) @map("id")
  code        String   @unique(map: "uq_contact_method_types_code") @map("code") @db.VarChar(64)
  name        String   @map("name") @db.VarChar(255)
  description String?  @map("description") @db.VarChar(2000)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  contactMethods ContactMethod[]

  @@index([isActive], map: "idx_contact_method_types_is_active")
  @@map("contact_method_types")
}

model SocialPlatform {
  id          String   @id @default(uuid()) @map("id")
  code        String   @unique(map: "uq_social_platforms_code") @map("code") @db.VarChar(64)
  name        String   @map("name") @db.VarChar(255)
  description String?  @map("description") @db.VarChar(2000)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  socialProfiles SocialProfile[]

  @@index([isActive], map: "idx_social_platforms_is_active")
  @@map("social_platforms")
}

model RoleLevel {
  id          String   @id @default(uuid()) @map("id")
  code        String   @unique(map: "uq_role_levels_code") @map("code") @db.VarChar(64)
  name        String   @map("name") @db.VarChar(255)
  description String?  @map("description") @db.VarChar(2000)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  employments Employment[]

  @@index([isActive], map: "idx_role_levels_is_active")
  @@map("role_levels")
}

model PermissionGroup {
  id          String              @id @default(uuid()) @map("id")
  code        String              @unique(map: "uq_permission_groups_code") @map("code") @db.VarChar(64)
  name        String              @map("name") @db.VarChar(255)
  kind        PermissionGroupKind @default(DOMAIN) @map("kind")
  description String?             @map("description") @db.VarChar(2000)
  sortOrder   Int                 @default(0) @map("sort_order")
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  permissions Permission[]

  @@index([isActive], map: "idx_permission_groups_is_active")
  @@map("permission_groups")
}

model Company {
  id                   String        @id @default(uuid()) @map("id")
  name                 String        @map("name") @db.VarChar(255)
  legalName            String?       @map("legal_name") @db.VarChar(255)
  tradingName          String?       @map("trading_name") @db.VarChar(255)
  registrationNumber   String?       @map("registration_number") @db.VarChar(128)
  taxVatId             String?       @map("tax_vat_id") @db.VarChar(128)
  jurisdiction         String?       @map("jurisdiction") @db.VarChar(2)
  status               CompanyStatus @default(ACTIVE) @map("status")
  isCanonical          Boolean       @default(false) @map("is_canonical")
  anonymizedAt         DateTime?     @map("anonymized_at") @db.Timestamptz
  anonymizationTokenId String?       @map("anonymization_token_id") @db.VarChar(128)
  importSourceRef      String?       @map("import_source_ref") @db.VarChar(255)

  createdById String?   @map("created_by_id")
  createdBy   User?     @relation("CompanyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
